# APPLICATION
APP_NAME="BISIG Hulong Duhat"
APP_ENV=production
APP_KEY=base64:PASTE_NEW_GENERATED_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://your-app.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# LOGGING
LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# DATABASE - SUPABASE POSTGRESQL POOLER
DB_CONNECTION=pgsql
DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.pxzxgegygwggabbtxfyj
DB_PASSWORD="PASTE_NEW_SUPABASE_DATABASE_PASSWORD_HERE"
DB_SEARCH_PATH=public
DB_SSLMODE=require

# SESSION / CACHE / QUEUE / FILESYSTEM
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# DEPLOYMENT
RUN_MIGRATIONS=true

# APPLICATION PATHS / FRONTEND
ADMIN_PATH=bisig-admin-panel
VITE_APP_NAME="${APP_NAME}"

# EMAIL - GMAIL SMTP
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME="barangayhulongduhat@gmail.com"
MAIL_PASSWORD="PASTE_NEW_GMAIL_APP_PASSWORD_HERE"
MAIL_FROM_ADDRESS="barangayhulongduhat@gmail.com"
MAIL_FROM_NAME="BISIG Hulong Duhat"

# Optional: only needed if switch the mail provider to Resend.
RESEND_KEY="PASTE_NEW_RESEND_KEY_HERE"

# SMS - SEMAPHORE
SMS_PROVIDER=semaphore
SMS_API_BASE_URL=https://api.semaphore.co/api/v4/messages
SMS_API_KEY="PASTE_NEW_SEMAPHORE_API_KEY_HERE"
SMS_SENDER_NAME=HULONGDUHAT
SMS_DAILY_LIMIT=200
SMS_MONTHLY_LIMIT=3000
SMS_OTP_DAILY_LIMIT_PER_NUMBER=5
SMS_CREDITS_LEFT=1744
SMS_ACCOUNT_STATUS=Active
SMS_ACCOUNT_NAME="Barangay Hulong Duhat"
SMS_LAST_SYNCED_AT="2026-07-11 06:23:27"

# MAINTENANCE / ANALYTICS
MAINTENANCE_TOKEN="PASTE_A_LONG_RANDOM_MAINTENANCE_TOKEN_HERE"
MAINTENANCE_REQUEST_CATCHUP=true
PYTHON_BINARY=python

# AI / CHATBOT
AI_PROVIDER=cloudflare
AI_FALLBACK_PROVIDERS="groq,gemini"

# Keep BISIG-specific AI config consistent with the main provider.
BISIG_AI_PROVIDER=cloudflare
BISIG_AI_FALLBACK_PROVIDER=groq

CHATBOT_ORG_NAME="Barangay Hulong Duhat"
CHATBOT_ORG_LOCATION="Malabon, Philippines"
CHATBOT_AI_ENABLED=true

GEMINI_API_KEY="PASTE_NEW_GEMINI_API_KEY_HERE"
